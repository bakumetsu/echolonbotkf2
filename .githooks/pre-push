#!/bin/sh
# Turn on once per clone: git config core.hooksPath .githooks
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                  # deleting a branch
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes"                   # new branch: commits no remote has yet
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086  # $range is split on purpose
    sh "$(dirname "$0")/check-docs.sh" $range || status=1
done
exit $status
