{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "task",
 "description": "One atomic coding task: replace exactly one stub (function, event, state or defaultproperties) by symbol.",
 "type": "object",
 "required": ["id", "target", "tags", "parts", "bible_topics", "acceptance"],
 "properties": {
  "id": {"type": "string", "pattern": "^M[0-9][a-c]?-[0-9]{3,4}$"},
  "milestone": {"type": "string"},
  "target": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*){1,2}$"},
  "kind": {"enum": ["function", "event", "state", "defaultproperties"]},
  "tags": {"type": "array", "items": {"type": "string", "pattern": "^@SYS-[A-Z0-9-]+$"}},
  "parts": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}},
  "bible_topics": {"type": "array", "items": {"enum": ["states", "arrays", "iterators", "strings", "timers", "sdk"]}},
  "legacy_ref": {"type": ["string", "null"], "description": "Legacy Class.Symbol to use as behavioural reference"},
  "notes": {"type": "string", "maxLength": 1200},
  "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "status": {"enum": ["todo", "done", "failed", "escalated", "skipped"]}
 }
}
