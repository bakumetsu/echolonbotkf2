{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "models_config",
 "type": "object",
 "required": ["vram_budget_gb", "models"],
 "properties": {
  "vram_budget_gb": {"type": "number"},
  "models": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "backend", "endpoint", "model_name", "vram_gb", "temperature", "max_tokens", "role"],
    "properties": {
     "id": {"type": "string"},
     "backend": {"enum": ["ollama", "lmstudio", "openai_compat", "llama_swap", "mock"]},
     "endpoint": {"type": "string"},
     "model_name": {"type": "string"},
     "quantization": {"type": "string"},
     "vram_gb": {"type": "number"},
     "temperature": {"type": "number"},
     "max_tokens": {"type": "integer"},
     "think": {"type": "boolean"},
     "system_prompt_path": {"type": ["string", "null"]},
     "role": {"enum": ["orchestrator", "planner", "coder", "debugger", "doc"]},
     "structured_output": {"type": ["string", "null"]},
     "timeout_s": {"type": "number"}
    }
   }
  }
 }
}
