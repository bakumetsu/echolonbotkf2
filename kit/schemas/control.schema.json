{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "control",
 "description": "Schema-constrained control message a model may return INSTEAD of code, when it cannot do the task.",
 "type": "object",
 "required": ["status", "reason"],
 "properties": {
  "status": {"enum": ["need_info", "cannot", "contract_conflict"]},
  "reason": {"type": "string", "maxLength": 600},
  "missing": {"type": "array", "items": {"type": "string"}}
 },
 "additionalProperties": false
}
