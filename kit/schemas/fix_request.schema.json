{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "fix_request",
 "description": "Emitted by compile_loop for the debugger: the first compile error plus up to 2 more distinct locations.",
 "type": "object",
 "required": ["attempt", "errors", "summary"],
 "properties": {
  "attempt": {"type": "integer", "minimum": 1},
  "summary": {"type": "string"},
  "target": {"type": ["string", "null"], "description": "Class.Symbol being worked on, if known"},
  "errors": {
   "type": "array", "minItems": 1, "maxItems": 3,
   "items": {
    "type": "object",
    "required": ["file", "line", "msg", "slice"],
    "properties": {
     "file": {"type": "string"}, "line": {"type": "integer"}, "msg": {"type": "string"},
     "symbol": {"type": ["string", "null"]},
     "slice": {"type": "string"},
     "signatures": {"type": "array", "items": {"type": "string"}}
    }
   }
  }
 }
}
